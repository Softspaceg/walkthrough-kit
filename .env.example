# Copy this file to .env and fill it in. Never commit .env.

# The website to document (no path), for example https://test.example.com
BASE_URL=

# A login that can SEE the screens to document (read-only use: nothing is saved).
LOGIN_USER=
LOGIN_PASS=

# Optional: 3 (default) gives sharp, large images; 2 halves the file size.
SCALE=
